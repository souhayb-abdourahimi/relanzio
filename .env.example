PORT=3000
APP_URL=http://localhost:5173
NODE_ENV=development
RELEASE_STAGE=staging

# Browser-safe Supabase configuration. Vite exposes only VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server-side Supabase configuration. Never expose the service role key to VITE_*.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

BREVO_API_KEY=
EMAIL_FROM_NAME=Relanzio
EMAIL_FROM_ADDRESS=notifications@relanzio.com
SUPPORT_EMAIL=support@relanzio.com
CONTACT_EMAIL=contact@relanzio.com
BREVO_WEBHOOK_SECRET=

# Read-only inbound reply polling (OVH/Zimbra). Password must stay in Railway secrets only.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=notifications@relanzio.com
IMAP_PASSWORD=
# Client replies to follow-ups (product only, separate mailbox from prospection).
# Follow-ups get Reply-To <local>+<token>@<domain>; the mailbox must accept "+" sub-addressing.
# Leave empty to keep replies going straight to the artisan (no automatic stop, no automatic sending).
REPLY_INBOUND_ADDRESS=
REPLY_IMAP_HOST=
REPLY_IMAP_PORT=993
REPLY_IMAP_USER=
REPLY_IMAP_PASSWORD=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
# Optional: Stripe customer portal configuration (card update, cancel, invoices).
STRIPE_PORTAL_CONFIGURATION_ID=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

CRON_SECRET=
# Signs one-click unsubscribe links in client follow-ups and the morning digest (>=24 random chars).
EMAIL_LINK_SECRET=
ADMIN_EMAILS=you@example.com

# Public/legal values consumed by the Vite build.
VITE_SUPPORT_EMAIL=support@relanzio.com
VITE_CONTACT_EMAIL=contact@relanzio.com
VITE_BILLING_ENABLED=false
VITE_LEGAL_ENTITY_TYPE=
VITE_LEGAL_NAME=
VITE_LEGAL_FORM=
VITE_LEGAL_CAPITAL=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_EMAIL=
VITE_LEGAL_REGISTRATION=
VITE_LEGAL_VAT=
VITE_LEGAL_PHONE=
VITE_PUBLICATION_DIRECTOR=
VITE_HOST_NAME=
VITE_DATA_RETENTION=

# Safety switches: keep false until the corresponding QA gate is green.
BILLING_ENABLED=false
FOLLOWUP_AUTOMATION_ENABLED=false
LIFECYCLE_EMAILS_ENABLED=false
ACQUISITION_ENABLED=false
# Morning digest (service email, 07:30 Paris on business days). Keep false until QA.
MORNING_DIGEST_ENABLED=false
# Trial-ending, payment-failed and cancellation emails. Keep false until Stripe test E2E.
BILLING_EMAILS_ENABLED=false
OUTREACH_DAILY_CAP=5
PILOT_OUTREACH_DAILY_CAP=5
PILOT_OUTREACH_ALLOWED_EMAILS=

# Production release gates. Staging may remain false.
LEGAL_PAGES_APPROVED=false
EXTERNAL_QA_APPROVED=false
MOBILE_QA_APPROVED=false
